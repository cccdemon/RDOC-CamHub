# Build artifacts
/bin/
/dist/
# Anchor the binary patterns to the repo root so they don't shadow
# cmd/camhub/. A bare `camhub` would match any path component named
# camhub anywhere in the tree (incl. cmd/camhub/), which is wrong.
/camhub
/camhub.exe

# Local dev state
/data/
/secrets/
.env
.env.local
*.local.yaml

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Go
*.test
*.out
coverage.txt
