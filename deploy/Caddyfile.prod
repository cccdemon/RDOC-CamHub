{
	email admin@raumdock.org

	# This Caddy never owns :80 / :443 — those belong to RDOC-WEBRTC's Caddy
	# in the same LXC. The CamHub Caddy listens on :8443 only, behind the
	# LXC 101 nginx SNI router. So:
	#   - No HTTP→HTTPS redirect (no :80 to redirect from).
	#   - ACME via Cloudflare DNS-01 only.
	auto_https disable_redirects

	acme_dns cloudflare {env.CF_API_TOKEN}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}
}

# API host: JSON only. The CSP here is mostly cosmetic (no HTML
# response uses it) but `default-src 'none'` is the strictest baseline
# and signals intent.
api.camhub.raumdock.org:8443 {
	encode zstd gzip
	import security_headers
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	reverse_proxy camhub:8080 {
		header_up X-Forwarded-For   {remote_host}
		header_up X-Forwarded-Proto https
	}
}

# UI host: external CSS/JS (no inline). `connect-src` allows the JS
# refresh ticker and login submit to reach the API host.
app.camhub.raumdock.org:8443 {
	encode zstd gzip
	import security_headers
	header Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' https://api.camhub.raumdock.org; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	reverse_proxy camhub:8080 {
		header_up X-Forwarded-For   {remote_host}
		header_up X-Forwarded-Proto https
	}
}
