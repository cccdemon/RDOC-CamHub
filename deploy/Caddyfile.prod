{
	email admin@raumdock.org

	# This Caddy never owns :80 / :443 — those belong to RDOC-WEBRTC's Caddy
	# in the same LXC. The CamHub Caddy listens on :8443 only, behind the
	# LXC 101 nginx SNI router. So:
	#   - No HTTP→HTTPS redirect (no :80 to redirect from).
	#   - ACME via Cloudflare DNS-01 only.
	auto_https disable_redirects

	acme_dns cloudflare {env.CF_API_TOKEN}
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}
}

api.camhub.raumdock.org:8443 {
	encode zstd gzip
	import common_headers
	reverse_proxy camhub:8080 {
		header_up X-Forwarded-For   {remote_host}
		header_up X-Forwarded-Proto https
	}
}

app.camhub.raumdock.org:8443 {
	encode zstd gzip
	import common_headers
	reverse_proxy camhub:8080 {
		header_up X-Forwarded-For   {remote_host}
		header_up X-Forwarded-Proto https
	}
}
